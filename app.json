{
  "expo": {
    "name": "Alía",
    "slug": "alia-mobile",
    "version": "1.0.0",
    "scheme": "aliamobile",
    "orientation": "portrait",
    "icon": "./assets/images/icono_app.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1F2B25",
        "foregroundImage": "./assets/images/icono_app.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.juxchxx.aliamobile"
    },
    "web": {
      "favicon": "./assets/images/icono_app.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-web-browser"
    ]
  }
}
